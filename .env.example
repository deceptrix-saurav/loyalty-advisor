# Copy this file to .env (in this folder, or one folder above the repo) and fill in ONE of the two keys.
# Never commit the real .env.

# Course key (uses gpt-6-luna through Portkey):
PORTKEY_API_KEY=

# OR your own OpenAI key (set LLM_MODEL to a model you pay for):
OPENAI_API_KEY=

# ---- Optional ----
# LLM_MODEL=gpt-6-luna
# AGENT_MODE=agentic        # or: lean (cheaper, fewer model calls)
# PORT=8000
# If your class notebook calls Portkey with a provider, virtual key or config, set it here:
# PORTKEY_PROVIDER=
# PORTKEY_VIRTUAL_KEY=
# PORTKEY_CONFIG=
